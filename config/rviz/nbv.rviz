Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Next best view1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 200; 200; 200
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.6
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.25
    - Class: rviz_default_plugins/Path
      Name: Nav2 plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 210; 35; 30
      Line Style: Billboards
      Line Width: 0.03
      Alpha: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Next best view
      Enabled: true
      Topic:
        Value: /nbv/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: TSDF voxels
      Enabled: true
      Topic:
        Value: /nbv/tsdf
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Style: Boxes
      Size (m): 0.0075
      Alpha: 0.85
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Invert Rainbow: true
      Autocompute Intensity Bounds: false
      Min Intensity: 0.5
      Max Intensity: 1
      Selectable: false
    - Class: rviz_default_plugins/PointCloud2
      Name: TSDF surface
      Enabled: false
      Topic:
        Value: /nbv/surface
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Alpha: 1
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 90; 200; 120
      Selectable: false
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Follow the robot
      Distance: 3.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Pitch: 0.45
      Yaw: 3.1
      Target Frame: base_footprint
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Whole room
        Distance: 6.0
        Focal Point:
          X: -3.8
          Y: -4.1
          Z: 0.5
        Pitch: 0.7
        Yaw: 2.4
        Target Frame: <Fixed Frame>
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
