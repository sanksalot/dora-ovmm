# Python
__pycache__/
*.pyc

# ROS 2 colcon build artifacts (regenerated by colcon build)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# colcon dumps these wherever it is invoked from, not just in ros2_ws/. Any
# copy outside ros2_ws/ is junk from running it in the wrong directory.
build/
install/
log/

# Everything under ros2_ws/src/ is a separately cloned vendor repo
# (its own .git directory) except grasp_execution/ and hsr_rgbd/, which are ours.
ros2_ws/src/*
!ros2_ws/src/grasp_execution/
!ros2_ws/src/hsr_rgbd/
!ros2_ws/src/moveit_simple_controller_manager/

# Secrets: HF_TOKEN and the cached HF login it produces
docker/sam3/.env
docker/sam3/checkpoints/
/.env

# GraspGenX model weights (multi-GB, not source)
docker/graspgenx/checkpoints/

# Generated per-run outputs from core/run_pipeline.py, not source
config/targets/

# Recorded runs. Useful to keep around locally while tuning navigation, but
# they are measurements, not source, and they get large fast.
bags/
docs/
.image_fingerprint
config/reconstruction
# generic files 
data_hrl/
/outputs
/tests
/docs
#vscode
.vscode
CLAUDE.md
fixes/
TROUBLESHOOTING.md
rosgraph.png
visual_learning/
DEMO_DAY.md
fixes/
presentation_videos/
/presentation_videos/
